#!/usr/bin/env bash
set -euo pipefail

# Git pre-commit hook for the gitops repo
# 1. Formats staged YAML files to KYAML
# 2. Runs kustomize build check on staged YAML files

STAGED_YAML=$(git diff --cached --name-only --diff-filter=ACM -- '*.yaml')
[ -z "$STAGED_YAML" ] && exit 0

REPO_ROOT="$(git rev-parse --show-toplevel)"

# --- KYAML formatting ---
kyaml_count=0
while IFS= read -r f; do
  [ -f "$f" ] || continue
  yamlfmt -o kyaml -w "$f"
  git add "$f"
  kyaml_count=$((kyaml_count + 1))
done <<< "$STAGED_YAML"

if [ "$kyaml_count" -gt 0 ]; then
  echo "kyaml: formatted $kyaml_count file(s)"
fi

# --- Kustomize build check ---
declare -A kustomize_cache

while IFS= read -r f; do
  [ "$(basename "$f")" = "kustomization.yaml" ] && continue
  [ -f "$f" ] || continue

  file_dir=$(dirname "$f")
  dir="$file_dir"
  while [ "$dir" != "$REPO_ROOT" ] && [ "$dir" != "/" ]; do
    if [ -f "$dir/kustomization.yaml" ]; then
      if [[ -z "${kustomize_cache[$dir]:-}" ]]; then
        kustomize_cache[$dir]=$(kubectl kustomize "$dir")
      fi
      build_output=${kustomize_cache[$dir]}

      identity=$(yq eval-all '.apiVersion + "|" + .kind + "|" + (.metadata.name // "")' "$f" 2>/dev/null)
      [ -z "$identity" ] && break

      rendered=$(echo "$build_output" | yq eval-all "
        select(.apiVersion + \"|\" + .kind + \"|\" + (.metadata.name // \"\") == \"$identity\")
      " - 2>/dev/null)

      if [ -n "$rendered" ]; then
        tmp=$(mktemp)
        echo "$rendered" > "$tmp"
        if ! diff -q "$f" "$tmp" > /dev/null 2>&1; then
          cp "$tmp" "$f"
          git add "$f"
        fi
        rm -f "$tmp"
      fi
      break
    fi
    dir=$(dirname "$dir")
  done
done <<< "$STAGED_YAML"
